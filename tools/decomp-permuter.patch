+class FastSequenceMatcher(difflib.SequenceMatcher):  # type: ignore
+    """A difflib.SequenceMatcher (no junk, autojunk=False) whose
+    find_longest_match gives exactly the same results, faster.
+
+    difflib's version walks b2j[a[i]] for every i, over all of b, so it costs
+    the number of equal (i, j) pairs: quadratic for long, similar sequences
+    with a small alphabet (instruction mnemonics). Here, small ranges use the
+    same dynamic programming, but only visit the j's inside [blo, bhi) (found
+    by bisection), and large ranges map elements to characters and binary
+    search the length of the longest common substring with string slicing.
+    In both cases the result is the longest match, the earliest in a, then
+    the earliest in b, which is what difflib documents and computes."""
+
+    # Below this many (a, b) element pairs, use the dynamic programming.
+    DP_LIMIT = 40000
+    # The smallest anchor block length tried before falling back to it.
+    MIN_ANCHOR = 4
+
+    def __init__(self) -> None:
+        self._codes: Dict[object, str] = {}
+        self._sa = ""
+        self._sb = ""
+        super().__init__(None, "", "", autojunk=False)
+
+    def _encode(self, seq: Sequence[object]) -> str:
+        codes = self._codes
+        out = []
+        for x in seq:
+            c = codes.get(x)
+            if c is None:
+                c = codes[x] = chr(len(codes))
+            out.append(c)
+        return "".join(out)
+
+    def set_seq1(self, a: Sequence[object]) -> None:
+        super().set_seq1(a)
+        self._sa = self._encode(a)
+
+    def set_seq2(self, b: Sequence[object]) -> None:
+        super().set_seq2(b)
+        self._sb = self._encode(b)
+
+    def find_longest_match(
+        self, alo: int = 0, ahi: Optional[int] = None, blo: int = 0, bhi: Optional[int] = None
+    ) -> difflib.Match:
+        if self.bjunk or self.bpopular:
+            return super().find_longest_match(alo, ahi, blo, bhi)
+        if ahi is None:
+            ahi = len(self.a)
+        if bhi is None:
+            bhi = len(self.b)
+        if (ahi - alo) * (bhi - blo) <= self.DP_LIMIT:
+            return self._dp_match(alo, ahi, blo, bhi)
+        return self._str_match(alo, ahi, blo, bhi)
+
+    def _dp_match(self, alo: int, ahi: int, blo: int, bhi: int) -> difflib.Match:
+        # difflib's loop, restricted to j in [blo, bhi).
+        a, b2j = self.a, self.b2j
+        besti, bestj, bestsize = alo, blo, 0
+        j2len: Dict[int, int] = {}
+        nothing: List[int] = []
+        for i in range(alo, ahi):
+            js = b2j.get(a[i], nothing)
+            lo = bisect_left(js, blo)
+            hi = bisect_left(js, bhi, lo)
+            j2lenget = j2len.get
+            newj2len: Dict[int, int] = {}
+            for j in js[lo:hi]:
+                k = newj2len[j] = j2lenget(j - 1, 0) + 1
+                if k > bestsize:
+                    besti, bestj, bestsize = i - k + 1, j - k + 1, k
+            j2len = newj2len
+        return difflib.Match(besti, bestj, bestsize)
+
+    def _str_match(self, alo: int, ahi: int, blo: int, bhi: int) -> difflib.Match:
+        # With the sequences as strings, look for matches through "anchor"
+        # blocks: at level q, the blocks sa[p:p+q] for p a multiple of q.
+        # Every common substring of length >= 2q-1 contains a whole anchor
+        # block, so finding each anchor's occurrences in sb (str.find) and
+        # extending them both ways finds all of those matches (each extension
+        # is the maximal match on its diagonal). If the best is >= 2q-1, it
+        # is the longest, and all the longest are among those found, so the
+        # earliest (i, j) is the answer. Otherwise halve q. Small q, or too
+        # many occurrences, fall back to the dynamic programming.
+        sa = self._sa[alo:ahi]
+        sb = self._sb[blo:bhi]
+        na, nb = len(sa), len(sb)
+        budget = 2 * (na + nb)
+        q = 1
+        while 2 * q <= min(na, nb):
+            q *= 2
+        while q >= self.MIN_ANCHOR:
+            best = 0
+            cands: List[Tuple[int, int]] = []
+            # diagonal (j - i) -> end of the last match extended on it
+            done: Dict[int, int] = {}
+            for p in range(0, na - q + 1, q):
+                block = sa[p : p + q]
+                j = sb.find(block)
+                while j >= 0:
+                    diag = j - p
+                    if done.get(diag, -1) < p + q:
+                        budget -= 1
+                        if budget < 0:
+                            return self._dp_match(alo, ahi, blo, bhi)
+                        lft = _common_suffix(sa, p, sb, j)
+                        rgt = _common_prefix(sa, p + q, sb, j + q)
+                        size = lft + q + rgt
+                        done[diag] = p + q + rgt
+                        if size > best:
+                            best = size
+                            cands = [(p - lft, j - lft)]
+                        elif size == best:
+                            cands.append((p - lft, j - lft))
+                    j = sb.find(block, j + 1)
+            if best >= 2 * q - 1:
+                i, j = min(cands)
+                return difflib.Match(alo + i, blo + j, best)
+            q //= 2
+        return self._dp_match(alo, ahi, blo, bhi)
+
+
+def _common_prefix(s1: str, i1: int, s2: str, i2: int) -> int:
+    """Length of the common prefix of s1[i1:] and s2[i2:]."""
+    hi = min(len(s1) - i1, len(s2) - i2)
+    if hi <= 0 or s1[i1] != s2[i2]:
+        return 0
+    # Gallop, then bisect: s1[i1:i1+lo] == s2[i2:i2+lo], and not for hi+1.
+    lo, step = 1, 1
+    while True:
+        step *= 2
+        if step >= hi:
+            break
+        if s1[i1 : i1 + step] != s2[i2 : i2 + step]:
+            hi = step - 1
+            break
+        lo = step
+    if s1[i1 : i1 + hi] == s2[i2 : i2 + hi]:
+        return hi
+    hi -= 1
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if s1[i1 : i1 + mid] == s2[i2 : i2 + mid]:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
+
+
+def _common_suffix(s1: str, e1: int, s2: str, e2: int) -> int:
+    """Length of the common suffix of s1[:e1] and s2[:e2]."""
+    hi = min(e1, e2)
+    if hi <= 0 or s1[e1 - 1] != s2[e2 - 1]:
+        return 0
+    lo, step = 1, 1
+    while True:
+        step *= 2
+        if step >= hi:
+            break
+        if s1[e1 - step : e1] != s2[e2 - step : e2]:
+            hi = step - 1
+            break
+        lo = step
+    if s1[e1 - hi : e1] == s2[e2 - hi : e2]:
+        return hi
+    hi -= 1
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if s1[e1 - mid : e1] == s2[e2 - mid : e2]:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
