+    the terrible things we've done to them in normalize_ast.
+
+    With ext_cache, top-level items found in it (by identity) aren't
+    regenerated: their code only depends on them and the indentation, which
+    is 0 between items."""
+
+    ext_cache: Optional["ExtCache"] = None
+
+    def _visit_ext(self, ext: ca.Node) -> str:
+        # CGenerator.visit_FileAST's code for one item.
+        if isinstance(ext, ca.FuncDef):
+            coord = ext.decl.coord
+            pre = f"#line {coord.line}\n" if coord is not None and coord.line else ""
+            # the header and its brace on one line, as in base.c
+            return pre + self.visit(ext).replace("\n{\n", " {\n", 1)  # type: ignore
+        elif isinstance(ext, ca.Pragma):
+            return self.visit(ext) + "\n"  # type: ignore
+        else:
+            return self.visit(ext) + ";\n"  # type: ignore
+
+    def visit_FileAST(self, n: ca.FileAST) -> str:
+        cache = self.ext_cache
+        if cache is None:
+            cache = {}
+        parts: List[str] = []
+        for ext in n.ext:
+            hit = cache.get(id(ext)) if self.indent_level == 0 else None
+            if hit is not None and hit[0] is ext:
+                parts.append(hit[1])
+            else:
+                parts.append(self._visit_ext(ext))
+        return "".join(parts)
+
+    def _generate_stmt(self, n: ca.Node, add_indent: bool = False) -> str:
+        # Keep base.c's line of every statement (#line): IDO allocates
+        # temporaries and orders blocks per source line, so a macro's
+        # statements must stay on one line as in base.c.
+        s: str = super()._generate_stmt(n, add_indent)  # type: ignore
